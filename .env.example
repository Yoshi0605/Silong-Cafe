# Copy this file to .env and edit
PORT=3000

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=silong123

# Local or cloud MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mysql
DB_NAME=silong_cafe
DB_CREATE_DATABASE=true

# Set true for TiDB, Aiven, or any SSL-required MySQL host
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM certificate (single-line \\n escapes are supported)
DB_SSL_CA=

# Cloudinary unsigned upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
